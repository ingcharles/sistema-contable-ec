// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MÓDULO: CONFIGURACIÓN
// ============================================

model Empresa {
  id                    String   @id @default(uuid())
  ruc                   String   @unique
  razonSocial           String
  nombreComercial       String?
  direccionMatriz       String
  obligadoContabilidad  Boolean  @default(true)
  contribuyenteEspecial String?
  agenteRetencion       Boolean  @default(false)
  email                 String?
  telefono              String?
  logo                  String?
  activo                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relaciones
  sucursales            Sucursal[]
  usuarios              Usuario[]
  productos             Producto[]
  categorias            CategoriaProducto[]
  bodegas               Bodega[]
  terceros              Tercero[]
  empleados             Empleado[]
  cuentasContables      CuentaContable[]
  centrosCosto          CentroCosto[]
  comprobantes          Comprobante[]
  cuentasBancarias      BancoCuenta[]
  documentosCartera     CarteraDocumento[]
  transportistas        Transportista[]

  @@map("empresas")
}

model Sucursal {
  id              String   @id @default(uuid())
  empresaId       String
  codigo          String
  nombre          String
  direccion       String
  telefono        String?
  email           String?
  esMatriz        Boolean  @default(false)
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  empresa         Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  puntosEmision   PuntoEmision[]

  @@unique([empresaId, codigo])
  @@map("sucursales")
}

model PuntoEmision {
  id              String   @id @default(uuid())
  sucursalId      String
  codigo          String
  nombre          String
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Secuenciales SRI
  secuencialFactura         Int @default(1)
  secuencialNotaCredito     Int @default(1)
  secuencialNotaDebito      Int @default(1)
  secuencialGuiaRemision    Int @default(1)
  secuencialRetencion       Int @default(1)

  // Relaciones
  sucursal        Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  comprobantes    Comprobante[]

  @@unique([sucursalId, codigo])
  @@map("puntos_emision")
}

model CodigoRetencion {
  id              String   @id @default(uuid())
  codigo          String
  concepto        String
  porcentaje      Float
  tipo            String   // 'RENTA' | 'IVA'
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("codigos_retencion")
}

// ============================================
// MÓDULO: USUARIOS Y SEGURIDAD
// ============================================

model Usuario {
  id              String   @id @default(uuid())
  empresaId       String
  email           String   @unique
  nombre          String
  password        String
  rol             String   // 'ADMIN' | 'CONTADOR' | 'VENDEDOR' | 'USUARIO'
  
  // Suscripción
  planId          String?  @map("plan_id")
  planStatus      String?  @default("ACTIVE") @map("plan_status") // 'ACTIVE', 'EXPIRED'
  planStartDate   DateTime? @map("plan_start_date")
  planEndDate     DateTime? @map("plan_end_date")

  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  plan            Plan?    @relation(fields: [planId], references: [id])

  @@map("usuarios")
}

// ============================================
// MÓDULO: INVENTARIO
// ============================================

model CategoriaProducto {
  id                      String   @id @default(uuid())
  empresaId               String
  nombre                  String
  descripcion             String?
  activo                  Boolean  @default(true)
  
  // Contabilización automática
  cuentaInventario        String?
  cuentaCostoVenta        String?
  cuentaIngreso           String?
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relaciones
  empresa                 Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  productos               Producto[]

  @@map("categorias_producto")
}

model Producto {
  id                      String   @id @default(uuid())
  empresaId               String
  categoriaId             String?
  codigoPrincipal         String
  codigoAuxiliar          String?
  nombre                  String
  descripcion             String?
  unidadMedida            String   @default("UND")
  precio                  Float
  costo                   Float    @default(0)
  stock                   Float    @default(0)
  stockMinimo             Float    @default(0)
  codigoTarifaIva         String   @default("2") @map("codigo_tarifa_iva") // 0%, 12%, 15%, etc
  grabaIva                Boolean  @default(true) @map("graba_iva")
  tipo                    String   @default("BIEN") // 'BIEN' | 'SERVICIO'
  activo                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relaciones
  empresa                 Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  categoria               CategoriaProducto? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  movimientosKardex       MovimientoKardex[]
  detallesComprobante     DetalleComprobante[]

  @@unique([empresaId, codigoPrincipal])
  @@map("productos")
}

model Bodega {
  id              String   @id @default(uuid())
  empresaId       String
  codigo          String
  nombre          String
  direccion       String?
  responsable     String?
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  empresa         Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimientos     MovimientoKardex[]

  @@unique([empresaId, codigo])
  @@map("bodegas")
}

model MovimientoKardex {
  id                      String   @id @default(uuid())
  productoId              String
  bodegaId                String
  fecha                   DateTime
  tipo                    String   // 'COMPRA' | 'VENTA' | 'AJUSTE_ENTRADA' | 'AJUSTE_SALIDA' | 'TRASLADO'
  referenciaComprobante   String?
  cantidadEntrada         Float    @default(0)
  cantidadSalida          Float    @default(0)
  costoUnitario           Float
  valorEntrada            Float    @default(0)
  valorSalida             Float    @default(0)
  saldoCantidad           Float
  saldoValor              Float
  createdAt               DateTime @default(now())

  // Relaciones
  producto                Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  bodega                  Bodega   @relation(fields: [bodegaId], references: [id], onDelete: Cascade)

  @@map("movimientos_kardex")
}

// ============================================
// MÓDULO: DIRECTORIO (TERCEROS)
// ============================================

model Tercero {
  id                      String   @id @default(uuid())
  empresaId               String   @map("empresa_id")
  tipoIdentificacion      String   @map("tipo_identificacion") // '04', '05', etc
  identificacion          String
  razonSocial             String   @map("razon_social")
  nombreComercial         String?  @map("nombre_comercial")
  direccion               String?
  telefono                String?
  celular                 String?
  email                   String?
  
  // Ubicación
  provincia               String?
  ciudad                  String?
  codigoPostal            String?  @map("codigo_postal")

  // Clasificación y Comercial
  tipoTercero            String    @map("tipo_tercero") // 'CLIENTE', 'PROVEEDOR', 'AMBOS', etc
  esContribuyenteEspecial Boolean  @default(false) @map("es_contribuyente_especial")
  obligadoContabilidad    Boolean  @default(false) @map("es_obligado_contabilidad")
  
  limiteCredito           Float    @default(0) @map("limite_credito")
  diasCredito             Int      @default(0) @map("dias_credito")
  descuentoPorcentaje     Float    @default(0) @map("descuento_porcentaje")

  // Contabilidad
  cuentaContableCxc       String?  @map("cuenta_contable_cxc")
  cuentaContableCxp       String?  @map("cuenta_contable_cxp")

  activo                  Boolean  @default(true)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  // Relaciones
  empresa                 Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  comprobantes            Comprobante[]

  @@unique([empresaId, identificacion])
  @@map("terceros")
}

// ============================================
// MÓDULO: NÓMINA
// ============================================

model Empleado {
  id                      String   @id @default(uuid())
  empresaId               String   @map("empresa_id")
  cedula                  String
  nombres                 String
  apellidos               String
  email                   String?
  telefono                String?
  direccion               String?
  cargo                   String?
  departamento            String?
  sueldoBase              Float    @map("sueldo_base")
  fechaIngreso            DateTime @map("fecha_ingreso") @default(now())
  tipoContrato            String   @default("INDEFINIDO") @map("tipo_contrato")
  
  // Información bancaria
  banco                   String?
  tipoCuenta              String?  @map("tipo_cuenta")
  numeroCuenta            String?  @map("numero_cuenta")
  
  activo                  Boolean  @default(true)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  // Relaciones
  empresa                 Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, cedula])
  @@map("empleados")
}

// ============================================
// MÓDULO: CONTABILIDAD
// ============================================

model CuentaContable {
  id              String   @id @default(uuid())
  empresaId       String
  codigo          String
  nombre          String
  nivel           Int
  tipo            String   // 'ACTIVO' | 'PASIVO' | 'PATRIMONIO' | 'INGRESO' | 'GASTO'
  naturaleza      String?  // 'DEUDORA' | 'ACREEDORA'
  aceptaMovimiento Boolean @default(false) @map("acepta_movimiento")
  activo          Boolean  @default(true) @map("activa")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, codigo])
  @@map("cuentas_contables")
}

model CentroCosto {
  id              String   @id @default(uuid())
  empresaId       String
  codigo          String
  nombre          String
  descripcion     String?
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, codigo])
  @@map("centros_costo")
}

// ============================================
// MÓDULO: FACTURACIÓN ELECTRÓNICA
// ============================================

model Comprobante {
  id                      String   @id @default(uuid())
  empresaId               String
  puntoEmisionId          String?
  terceroId               String?
  tipoComprobante         String   // 'FACTURA' | 'NOTA_CREDITO' | 'NOTA_DEBITO' | 'GUIA_REMISION' | 'RETENCION'
  fechaEmision            DateTime
  establecimiento         String   @default("001")
  puntoEmision            String   @default("001")
  secuencial              Int
  claveAcceso             String?
  numeroAutorizacion      String?
  estado                  String   @default("BORRADOR") // 'BORRADOR' | 'AUTORIZADO' | 'ERROR' | 'ANULADO'
  
  // Datos del cliente
  clienteIdentificacion   String
  clienteNombre           String
  clienteDireccion        String?
  clienteEmail            String?
  
  // Valores
  subtotal                Float
  descuento               Float    @default(0)
  subtotalConDescuento    Float
  iva                     Float
  total                   Float
  
  // Datos adicionales para guías
  direccionPartida        String?
  direccionDestino        String?
  transportistaNombre     String?
  placaVehiculo           String?
  
  // Metadata
  xmlGenerado             String?  @db.Text
  pdfGenerado             String?
  emailEnviado            Boolean  @default(false)
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relaciones
  empresa                 Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  puntoEmisionRel         PuntoEmision?       @relation(fields: [puntoEmisionId], references: [id], onDelete: SetNull)
  tercero                 Tercero?            @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  detalles                DetalleComprobante[]

  @@unique([empresaId, establecimiento, puntoEmision, secuencial, tipoComprobante])
  @@map("comprobantes")
}

model DetalleComprobante {
  id                      String   @id @default(uuid())
  comprobanteId           String
  productoId              String?
  codigoPrincipal         String
  descripcion             String
  cantidad                Float
  precioUnitario          Float
  descuento               Float    @default(0)
  subtotal                Float
  codigoIVA               String
  valorIVA                Float
  total                   Float
  
  createdAt               DateTime @default(now())

  // Relaciones
  comprobante             Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  producto                Producto?   @relation(fields: [productoId], references: [id], onDelete: SetNull)

  @@map("detalles_comprobante")
}

model Transportista {
  id              String   @id @default(uuid())
  empresaId       String   @map("empresa_id")
  identificacion  String
  razonSocial     String   @map("razon_social")
  placa           String
  email           String?
  telefono        String?
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, identificacion])
  @@map("transportistas")
}

// ============================================
// MÓDULO: BANCOS
// ============================================

model BancoCuenta {
  id              String   @id @default(uuid())
  empresaId       String   @map("empresa_id")
  numeroCuenta    String   @map("numero_cuenta")
  nombre          String
  tipoCuenta      String?  @map("tipo_cuenta")
  banco           String
  saldoActual     Float    @default(0) @map("saldo_actual")
  moneda          String   @default("USD")
  activa          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relaciones
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimientos     BancoMovimiento[]
  conciliaciones  BancoConciliacion[]

  @@unique([empresaId, numeroCuenta])
  @@map("bancos_cuentas")
}

model BancoMovimiento {
  id                String   @id @default(uuid())
  empresaId         String   @map("empresa_id")
  cuentaId          String   @map("cuenta_id")
  fecha             DateTime
  tipo              String   // 'CHEQUE' | 'TRANSFERENCIA' | 'DEPOSITO' | etc
  referencia        String?
  beneficiario      String?
  concepto          String?
  monto             Float
  esEgreso          Boolean  @map("es_egreso")
  conciliado        Boolean  @default(false)
  conciliacionId    String?  @map("conciliacion_id")
  createdAt         DateTime @default(now()) @map("created_at")

  cuenta            BancoCuenta        @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  conciliacion      BancoConciliacion? @relation(fields: [conciliacionId], references: [id], onDelete: SetNull)

  @@map("bancos_movimientos")
}

model BancoConciliacion {
  id                        String   @id @default(uuid())
  empresaId                 String   @map("empresa_id")
  cuentaId                  String   @map("cuenta_id")
  fechaCorte                DateTime @map("fecha_corte")
  saldoLibro                Float    @map("saldo_libro")
  saldoExtracto             Float    @map("saldo_extracto")
  chequesNoCobrados         Float    @default(0) @map("cheques_no_cobrados")
  depositosEnTransito       Float    @default(0) @map("depositos_en_transito")
  diferencia                Float    @default(0)
  estado                    String   @default("BORRADOR") // 'BORRADOR' | 'CUADRADO' | 'PENDIENTE'
  observaciones             String?  @db.Text
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  createdBy                 String?  @map("created_by")

  cuenta                    BancoCuenta       @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  movimientos               BancoMovimiento[]

  @@map("bancos_conciliaciones")
}

// ============================================
// MÓDULO: CARTERA
// ============================================

model CarteraDocumento {
  id                String   @id @default(uuid())
  empresaId         String   @map("empresa_id")
  tipoCartera       String   @map("tipo_cartera") // 'CXC' | 'CXP'
  tipoDocumento     String   @map("tipo_documento")
  nroComprobante    String   @map("nro_comprobante")
  terceroId         String   @map("tercero_id")
  terceroNombre     String   @map("tercero_nombre")
  fechaEmision      DateTime @map("fecha_emision")
  fechaVencimiento  DateTime @map("fecha_vencimiento")
  montoTotal        Float    @map("monto_total")
  saldoPendiente    Float    @map("saldo_pendiente")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("cartera_documentos")
}

// ============================================
// MÓDULO: NÓMINA (COMPLEMENTO)
// ============================================

model NominaRol {
  id              String   @id @default(uuid())
  empresaId       String   @map("empresa_id")
  empleadoId      String   @map("empleado_id")
  periodo         String   // YYYY-MM
  totalIngresos   Float    @map("total_ingresos")
  totalEgresos    Float    @map("total_egresos")
  netoPagar       Float    @map("neto_pagar")
  estado          String   @default("BORRADOR")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([empresaId, empleadoId, periodo])
  @@map("nomina_roles")
}


// ============================================
// MÓDULO: SUSCRIPCIONES Y PLANES
// ============================================

model Plan {
  id              String   @id @default(uuid())
  codigo          String   @unique // 'GRATUITO', 'PROFESIONAL'
  nombre          String
  precioMensual   Float    @map("precio_mensual")
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relaciones
  features        PlanFeature[]
  usuarios        Usuario[]

  @@map("planes")
}

model PlanFeature {
  id              String   @id @default(uuid())
  planId          String   @map("plan_id")
  featureKey      String   @map("feature_key") // 'MAX_DOCS', 'IA_ACCESS'
  valueType       String   @map("value_type") // 'NUMBER', 'BOOLEAN'
  valueNumber     Int?     @map("value_number")
  valueBool       Boolean? @map("value_bool")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relaciones
  plan            Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_features")
}

