# ==============================================
# CONFIGURACIÓN DE BASE DE DATOS - POSTGRESQL
# ==============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecucontable
DB_USER=postgres
DB_PASSWORD=postgres

# ==============================================
# CONFIGURACIÓN DE AUTENTICACIÓN - JWT
# ==============================================
# ⚠️ IMPORTANTE: Cambiar estos secretos en producción
JWT_SECRET=ecucontable-secret-key-CHANGE-IN-PRODUCTION-7x9m2k4p8q
JWT_REFRESH_SECRET=ecucontable-refresh-secret-CHANGE-IN-PRODUCTION-3n6h9j2s5t
JWT_EXPIRES_IN=8h

# ==============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ==============================================
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ==============================================
# SRI - FACTURACIÓN ELECTRÓNICA
# ==============================================
SRI_AMBIENTE=1
# 1 = Pruebas, 2 = Producción
SRI_TIPO_EMISION=1
# 1 = Normal, 2 = Contingencia
